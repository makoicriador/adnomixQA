        },
        {
          "action": "press",
          "target": "Enter"
        },
        {
          "action": "assert",
          "expected": "Result count >= 1 and a visible row contains the searched city"
        }
      ],
      "riskNotes": [
        "Location search only matches city/country as separate tokens; the composed \"City, Country\" display string returns 0 results — verified live, see project_conventions.md."
