    {
      "id": "suppliers-index-search-by-name",
      "title": "search bar finds a supplier by supplier name",
      "priority": "high",
      "tags": [
        "service-providers",
        "suppliers",
        "search",
        "smoke"
      ],
      "steps": [
        {
          "action": "setup",
          "data": "Logged in and navigated to Service Providers > Suppliers"
        },
        {
          "action": "fill",
          "target": "search input",
          "data": "an existing supplier name read live from the table"
        },
        {
          "action": "press",
          "target": "Enter"
        },
        {
          "action": "assert",
          "expected": "Result count >= 1 and a visible row contains the searched name"
        }
      ]
    },
