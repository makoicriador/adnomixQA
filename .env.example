# Base URL the generated Page Objects/tests navigate against.
BASE_URL=https://example.com

# Optional. If set, the Planner/Generator/Healer agents delegate reasoning
# to Claude instead of using their built-in heuristic fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# adxmanager.dev Service Providers > Suppliers E2E suite
# (tests/test_ServiceProviders_SuppliersIndex.spec.ts). Do not commit real
# credentials — this file only documents which variables are read.
ADX_BASE_URL=https://adxmanager.dev
ADX_USERNAME=
ADX_PASSWORD=
